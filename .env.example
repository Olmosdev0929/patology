# --- Telegram ---
BOT_TOKEN=123456:ABC...            # from @BotFather
BOT_USERNAME=PathoUzBot            # without @
WEBAPP_URL=https://pathouz.up.railway.app   # public HTTPS URL of this service
SUPER_ADMIN_IDS=123456789          # Telegram user IDs promoted to Super Admin on login

# --- Security ---
# If empty, a random secret is generated once and kept in /data/.jwt_secret (needs the /data volume).
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Railway Postgres plugin sets this automatically; leave empty to use the embedded server.
# DATABASE_URL=postgresql://user:pass@host:5432/pathouz

# --- Optional ---
SEED_ON_START=1      # load atlas / inventory / academy reference data if missing
SEED_DEMO=0          # 1 = add three demo biopsies
DEV_MODE=0           # 1 = enable /api/auth/dev-login (never in production)
TZ_NAME=Asia/Tashkent
DIGEST_HOUR=8        # daily expiry digest time
EXPIRY_WARNING_DAYS=60
SLOW_MOVER_MAX_30D=5
FAST_MOVER_MIN_30D=20
LOW_STOCK_TESTS=10

# --- Large books (PDF) ---
MAX_BOOK_MB=2048          # largest single PDF accepted
UPLOAD_CHUNK_MB=16        # max size of one upload request (the web client sends 8 MB)
UPLOAD_TTL_HOURS=48       # unfinished uploads are deleted after this
DISK_RESERVE_MB=512       # an upload is refused if it would leave less free space than this
PDF_WORKER_MEM_MB=1024    # memory cap of the background text-extraction process
PDF_WORKER_TIMEOUT_S=600  # per 200-page window
